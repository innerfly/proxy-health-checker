# Copy this file to .env and adjust the values for your environment.
#
# PROXY_LIST supports continuation lines:
# - Start with `PROXY_LIST=` on the first line
# - Put one proxy per following line
# - The application joins them internally into a comma-separated list
#
# Supported formats:
# - http://username:password@proxy.example.com:80
# - https://proxy.example.com:443
# - socks5://proxy.example.com:1080
# - tg://proxy?server=tg.example.com&port=443&secret=00000000000000000000000000000000
# - vless://uuid@proxy.example.com:443?type=tcp&encryption=none&security=reality&pbk=...&fp=chrome&sni=example.com&sid=...&spx=%2F#name

# Optional. If omitted, defaults to http://www.google.com
TEST_URL=google.com

PROXY_LIST=
http://username:password@proxy.example.com:80
https://proxy.example.com:443
socks5://proxy.example.com:1080
tg://proxy?server=tg.example.com&port=443&secret=eed598b8895c9b2b43d67d931cd5fed7ab79616e6465782e7275
vless://07842c30-a056-4f60-a624-6a0d7ad5a4f2@vpn.example.com:443?type=tcp&encryption=none&security=reality&pbk=9OoQlQq62iGD33uJ9Q4_FY4chLxK1tQp43bGKDDFHlM&fp=chrome&sni=vk.com&sid=c8c8022a&spx=%2F#vless
