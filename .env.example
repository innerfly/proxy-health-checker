# List of proxies to check (one per line after PROXY_LIST)
# Supported formats: http://, https://, socks5://
PROXY_LIST=
http://username:password@proxy.example.com:80
https://username:password@proxy.example.com:443
socks5://username:password@proxy.example.com:1080

# URL to test proxy connectivity
TEST_URL=google.com
